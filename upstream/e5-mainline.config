# Mainline config for the E5 (UMS9621, qogirn6lite), merged on top of allnoconfig by build.sh.
# Every option here must be taken by Kconfig as written, or the build stops (config-ignored.txt lists the
# known exceptions).  Grown one milestone at a time; mu300-linux/upstream/mu300-mainline.config is the
# model for what comes next.

# --- milestone 1: the kernel boots on the vendor DTB, reaches /init and leaves its log in ramoops
CONFIG_64BIT=y
CONFIG_ARCH_SPRD=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM_PSCI_FW=y
# Stock E5/T551M/M8 enable PSCI idle on the same vendor DT idle states.
# This idles individual CPUs; it does not suspend userspace or slow polling.
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_MULTIPLE_DRIVERS=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_LOCALVERSION="-e5"
CONFIG_LOCALVERSION_AUTO=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_TTY=y
CONFIG_SERIAL_SPRD=y
CONFIG_SERIAL_SPRD_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_BLK_DEV_INITRD=y
# LK hands over the ramdisk as an LZ4 legacy frame (FINDINGS 1)
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_OF=y
CONFIG_DEBUG_FS=y
# the log of a boot: the stock DT reserves ramoops@fff80000 (console, pmsg, dmesg records), which Android
# shows afterwards in /sys/fs/pstore
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PANIC_TIMEOUT=5
# hangs become panics, and a panic reaches ramoops
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
# LK's command line is the Android one (initcall_debug, root=/dev/ram0, Android's firmware paths): ours
# replaces it.  earlycon is the UART LK leaves running; the *_ignore_unused keep what LK switched on while
# the clock, power-domain and regulator drivers are not there yet.
# e5.openwrt: while mainline is on trial, boot/init starts a copy of the OpenWrt image (e5linux/
# openwrt-mainline.ext4, whose default boot is android), not the one in use.
# tty0 (the panel's fbcon, once the display modules load) before the serial console: kernel messages on the
# screen as well, the serial one last so it stays /dev/console
CONFIG_CMDLINE="earlycon=sprd_serial,0x20210000,115200n8 console=tty0 console=ttyS1,115200n8 loglevel=7 log_buf_len=1M printk.devkmsg=on rdinit=/init panic=5 softlockup_panic=1 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fw_devlink=permissive e5.openwrt=openwrt-mainline.ext4"
CONFIG_CMDLINE_FORCE=y
CONFIG_RANDOMIZE_BASE=n
# the reset: PSCI SYSTEM_RESET never returns on this firmware family; the ADI resets through the UMP9620
# (commit "spi: sprd-adi: add UMS9620 (UMP9620 PMIC) support with restart handler")
CONFIG_SPI=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_SPI_SPRD_ADI=y
# the power-off: PSCI SYSTEM_OFF resets on this firmware (a "poweroff" came back up, LK boot cause "Reboot
# into normal"); the UMP9620 powers off through its PWR_PD_HW (sc27xx-poweroff, "sprd,ump9620-poweroff")
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SC27XX=y
# the root is a loop image in userdata's F2FS, which OpenWrt cannot unmount: on a restart or power off, every
# filesystem is remounted read-only first (the image's, then userdata's -- a clean unmount checkpoint), not left
# dirty under the reset.  Twice userdata's F2FS was found after a reset with foreign blocks in its NAT
CONFIG_REBOOT_REMOUNT_RO=y

# --- milestone 2: clocks, pinctrl, PMIC, eMMC, USB
# the UMS9621 clock and gate controllers (commits "clk: sprd: ..."); their registers are partly syscons
# (sprd,ums9621-glbregs)
CONFIG_COMMON_CLK=y
CONFIG_SPRD_COMMON_CLK=y
CONFIG_SPRD_UMS9621_CLK=y
CONFIG_SPRD_SC9860_CLK=n
CONFIG_SPRD_SC9863A_CLK=n
CONFIG_SPRD_UMS512_CLK=n
CONFIG_MFD_SYSCON=y
CONFIG_REGMAP_MMIO=y
CONFIG_RESET_CONTROLLER=y
# Runtime IIS routing for Bluetooth SCO; LK's initial matrix is insufficient.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SPRD_QOGIRN6LITE=y
# the three PMICs behind the ADI (UMP9620 main, UMP9621, UMP9622) and the regulators of the first two
CONFIG_MFD_SC27XX_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_UMP9620=y
CONFIG_REGULATOR_UMP9621=y
# the PMIC watchdog LK arms for 300 s: taken over and fed by the watchdog core until userspace opens it
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_UMP9620_PMIC_WATCHDOG=y
# eMMC (and the SD/WCN controllers of the same IP): the UMS9621 r11p3 controller, its UMP9620 supply
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_SPRD=y
# power management: runtime PM (the USB controller and PHY are built on it) and wakeup sources (without
# PM_SLEEP wakeup_source_register() is a stub that returns NULL, and the Type-C driver fails its probe)
CONFIG_PM=y
CONFIG_SUSPEND=y
# USB (device mode): the PMIC's Type-C controller is the cable detection (extcon) the controller follows
CONFIG_USB_SUPPORT=y
CONFIG_EXTCON=y
CONFIG_TYPEC=y
CONFIG_USB_SC27XX_TYPEC=y
CONFIG_USB_PHY=y
CONFIG_SPRD_BC1P2=y
CONFIG_SPRD_QOGIRN6LITE_USB2_PHY=y
# the MUSB controller (dual role as on 5.15; the gadget is what boot/init uses: NCM + ACM over configfs)
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_SPRD=y
CONFIG_USB_SPRD_DMA=y
CONFIG_USB_SPRD_DMA_V3=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_UNIX98_PTYS=y
# what the Type-C controller needs: its CC calibration from the UMP9620 eFuse (read only), and the vbus
# extcon of the vendor DT (linux,extcon-usb-gpio on a PMIC EIC line)
CONFIG_NVMEM=y
CONFIG_NVMEM_SC27XX_EFUSE=y
# the SoC's eFuse (aon efuse@160000, sprd,qogirn6lite-efuse): the SoC sensors' calibration; read only here
CONFIG_NVMEM_SPRD_EFUSE=y
# the vendor DT names two eFuse cells alike (calib@48,0): with the per-cell sysfs files of 6.x the provider
# does not register at all (5.15 had none)
CONFIG_NVMEM_SYSFS=n
CONFIG_GPIOLIB=y
CONFIG_GPIO_SPRD=y
CONFIG_GPIO_EIC_SPRD=y
CONFIG_GPIO_PMIC_EIC_SPRD=y
CONFIG_EXTCON_USB_GPIO=y

# --- milestone 2b: boot/init and the OpenWrt/Debian userspace (after mu300-linux's OpenWrt 25.12 + Ubuntu set)
# userdata is f2fs, the systems are ext4 images on it (loop)
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
# Android 13's userdata has quota (mounting it read-write needs QUOTA), compression, file-based
# encryption, verity and casefolding: the same f2fs as the 5.15 kernel
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QFMT_V2=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_UNICODE=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
# no /dev/mem: boot/init's diagnostic read of the SoC watchdog (0x641e0000) raised an SError on mainline,
# where nothing has that watchdog's clock gate open (5.15's sprd_wdt_fiq does); without /dev/mem it skips it
CONFIG_DEVMEM=n
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_PRESERVE_MTIME=y
CONFIG_OF_GPIO=y
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_DMIID=n
CONFIG_KEYS=y
CONFIG_SECURITY=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_MEMFD_CREATE=y
CONFIG_INPUT_EVDEV=y
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_SYN_COOKIES=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_INET_DIAG=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_WIREGUARD=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_FIB_NETDEV=y
CONFIG_NFT_FWD_NETDEV=y
CONFIG_NFT_BRIDGE_META=y
CONFIG_NFT_BRIDGE_REJECT=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP_SET=y
CONFIG_PPP=y
CONFIG_PPP_ASYNC=y

# --- milestone 3: Wi-Fi and Bluetooth, the UMW2652 (marlin3lite) combo chip over SDIO
# Unisoc's WCN core (wcn_bsp.ko), fullmac Wi-Fi (sprd_wlan_combo.ko) and BT tty (sprdbt_tty.ko), as modules:
# boot/init loads them after it copied the device's WCN firmware from userdata (early_device_firmware)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=y
# not the input-driven rfkill: with it, the WCN tty's persistent, blocked bluetooth switch (the chip stays
# off until ttyBT0 is opened) blocks every bluetooth switch, and hci0 then refuses to come up (ERFKILL); 5.15
# has it off too
# (a choice only under EXPERT, which the 5.15 GKI config sets as well)
CONFIG_EXPERT=y
CONFIG_RFKILL_INPUT=n
CONFIG_SC23XX=y
CONFIG_UMW2652=y
CONFIG_UNISOC_WCN_BSP=m
CONFIG_UNISOC_WCN_BSP_USER_VARIANT=y
CONFIG_SDIOHAL=y
CONFIG_WCN_BOOT=y
CONFIG_WCN_SLP=y
CONFIG_UNISOC_WLAN_COMBO=m
CONFIG_UNISOC_WCN_BT=m
# the WCN core also carries the integrated chips' SIPC transport, so it links against Unisoc's SIPC core
# (the modem's AP/CP IPC, milestone 4): mailbox r2 and sipc-core, as on 5.15
CONFIG_MAILBOX=y
CONFIG_UNISOC_MAILBOX=m
CONFIG_UNISOC_MAILBOX_R2=y
CONFIG_UNISOC_MODEM_POWER_MANAGER=m
CONFIG_UNISOC_SIPC=m
# the PMIC's RTC (also what the WCN and Wi-Fi drivers' log timestamps need: rtc_time64_to_tm)
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_SC27XX=y
# Bluetooth: the chip's BT core on /dev/ttyBT0 (sprdbt_tty), attached by OpenWrt's e5-bt with btattach (H4);
# hci_uart writes its pskey and RF configuration first (BT_HCIUART_SPRD, sprd/marlin3lite_{pskey,rf}.bin)
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_SPRD=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_INPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_UHID=y

# --- milestone 4: the modem, as on 5.15 (module-order.txt): the CP is booted by Android's modem_control in
# the vendor chroot through the modem loader; AT over SIPC (sipc_wwan, ModemManager), data over SIPA (sipa_eth0)
CONFIG_WWAN=y
CONFIG_UNISOC_MODEM=m
CONFIG_UNISOC_MODEM_LOADER=m
CONFIG_UNISOC_CP_DUMP=m
CONFIG_UNISOC_IQ=m
CONFIG_UNISOC_SIPC_VIRT_BUS=m
CONFIG_UNISOC_SIPC_SPIPE=m
CONFIG_UNISOC_SIPC_WWAN=m
CONFIG_UNISOC_SIPC_SPOOL=m
CONFIG_UNISOC_SIPC_SLOG_BRIDGE=m
CONFIG_UNISOC_SIPC_SLOG_BRIDGE_5G=y
CONFIG_UNISOC_SIPC_SBUF_BRIDGE=m
CONFIG_UNISOC_SIPC_SBLOCK_BRIDGE=m
CONFIG_UNISOC_SIPC_ZERO_COPY_SIPX=m
CONFIG_UNISOC_SIPC_MEM_CACHE_EN=y
CONFIG_UNISOC_SIPA_SYS=m
CONFIG_UNISOC_SIPA_V3=m
CONFIG_UNISOC_SIPA_ETH=m
CONFIG_UNISOC_SIPA_USB=m
CONFIG_UNISOC_SIPA_DELEGATE=m
CONFIG_UNISOC_URSP_REPORT=m
# not the IMS bridge (VoLTE/VoWiFi between the CP's IMS stack and the AP): 5.15 builds it, nothing loads it
CONFIG_SPRD_IMS_BRIDGE=n
CONFIG_SPRD_SYSTIMER=y
CONFIG_SPRD_TIME_SYNC=m
CONFIG_SPRD_TIME_SYNC_CH=m
CONFIG_SPRD_TIME_SYNC_CP=m
# LK hands the slot over as androidboot.slot_suffix in the bootconfig behind the initrd, which is where
# modem_control reads it (without it, it asks for nr_fixnv1 and friends with no suffix); FORCE, since the
# forced command line lacks LK's "bootconfig"
CONFIG_BOOT_CONFIG=y
CONFIG_BOOT_CONFIG_FORCE=y
# Trusty, which modem_control asks to unlock the CP's DDR before it loads the CP: as on 5.15, the core, IRQ,
# PM, virtio and IPC in the kernel (with the virtio core), log, TSHM and TUI modules
CONFIG_TRUSTY=y
CONFIG_TRUSTY_VIRTIO=y
CONFIG_TRUSTY_VIRTIO_IPC=y
CONFIG_VIRTIO=y
CONFIG_TRUSTY_LOG=m
CONFIG_SPRD_TSHM=m
CONFIG_TRUSTY_TUI=m
# /sys/power/wake_lock, which modem_control holds while it loads the CP (5.15: on, no limit, no GC)
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0
CONFIG_PM_WAKELOCKS_GC=n

# --- milestone 5: the display (sprd DRM: DPU, DSI, the panel), touch, keypad, vibrator
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_PWM=y
CONFIG_PWM_SPRD=y
CONFIG_UNISOC_DISP=m
CONFIG_DRM_SPRD_DPU0=y
CONFIG_DRM_SPRD_DSI=y
# not GSP for now: the blitter of Android's composer; the mainline userspace has no user for it
CONFIG_UNISOC_GSP=n
# /dev/fb0 on the KMS device, as on 5.15 (the fbdev flavour of the Mali UMD), and its console
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# the DPU's power domain (5.15: a module)
CONFIG_SPRD_VPU_PW_DOMAIN=m
# Original qogirl6l camera domains are shut down until a genpd consumer needs them.
CONFIG_SPRD_CAMSYS_PD=y
# the display/GSP IOMMU (5.15: built in), for imported dma-bufs
CONFIG_UNISOC_IOMMU=m
# input, as on 5.15: the gpio-keys (power, volume, smart voice), the matrix keypad, the tlsc6x touch panel,
# the PMIC's vibrator
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_SPRD=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_TLSC6X=m
CONFIG_INPUT_MISC=y
CONFIG_INPUT_SC27XX_VIBRA=m
# the I2C controllers (touch panel, LCD bias; charger and PA later) and /dev/i2c-*, as on 5.15
CONFIG_I2C_SPRD=y
CONFIG_I2C_CHARDEV=y
# (the vibrator's force-feedback core, in the kernel rather than one more module to order)
CONFIG_INPUT_FF_MEMLESS=y

# --- milestone 8 (brought forward: the info screen's cog renders through EGL): the Mali-G57 on panfrost, as
# on 5.15 (kbase is not used there either)
CONFIG_DRM_PANFROST=m
# the PMIC's RGB status LED (mobile-data, ufi-tools) and its triggers, as on 5.15
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_SC27XX_BLTC=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_TRANSIENT=y
CONFIG_LEDS_TRIGGER_PATTERN=m

# --- milestone 6: charging and the battery, as on 5.15: Unisoc's charger manager with the AW32257 charger and
# the UMP96xx fuel gauge (its ADC channels through mainline's sc27xx_adc)
CONFIG_IIO=y
CONFIG_SC27XX_ADC=y
CONFIG_HWMON=y
CONFIG_POWER_SUPPLY_HWMON=y
CONFIG_CHARGER_MANAGER=m
CONFIG_FUEL_GAUGE_UMP96XX=m
CONFIG_CHARGER_AW32257=m
# thermal, as on 5.15: the SoC's two sensor blocks (r5p0), the PMIC's tsensors, the shell and SoC zones
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
# the board, PA and charger zones (generic-adc-thermal on the PMIC ADC; board-thmzone is charger-manager's)
CONFIG_GENERIC_ADC_THERMAL=y
# (built in, as 5.15 does, since their readings were checked on the device, 2026-09-28: the SoC's 21 sensor
# zones 38-41 C at a board of 38 C, soc-thmzone -- critical trip 110 C -- 40 C.  The PMIC tsensor runs in
# calibration mode only and ends its probe with -22 otherwise; front/back fail "virt temp diff": both as on 5.15.
# soc-thmzone (virtual_thermal) a module, loaded from the initramfs as on 5.15: built in, it probes before the
# sensor zones it is made of exist, and does not defer)
CONFIG_SPRD_THERMAL_R5P0=y
CONFIG_SPRD_UMP96XX_TSENSOR=y
CONFIG_SPRD_SHELL_THERMAL=y
CONFIG_UNISOC_SOC_THERMAL=m
# not the USB/UART/JTAG pin mux for now (5.15: a module): the first trial with it built in never showed up on
# USB again; suspected: the MUSB glue, probing again after a deferral, reads the mux as "open" and gives up
# ("usb mux jtag") -- to be checked against what the register holds before it comes back
CONFIG_SPRD_USBPINMUX=n

# --- milestone 7: audio, as on 5.15: ALSA/ASoC with the vendor UMP9620/VBC stack (the AGDSP brought up by
# OpenWrt's e5-audio from the root filesystem's modules, never at boot), and USB audio
# (high-resolution timers, as on 5.15, and the ALSA hrtimer backend on them)
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC=y
CONFIG_SND_JACK=y
# the DMA engine the PCM platforms take their channels from (sprd-pcm-audio: the AGCP DMA at 0x56650000;
# sprd-pcm-iis: the AP DMA): built in, as on 5.15 -- without it every hw_params failed with -ENODEV
# ("request dma channel(fast_p) failed!(-19)") and the speaker stayed silent
CONFIG_DMADEVICES=y
CONFIG_SPRD_DMA=y
CONFIG_SND_SOC_UNISOC=m
CONFIG_SND_SOC_UNISOC_PCM_ROUTING=m
CONFIG_SND_SOC_UNISOC_DMAENGINE_PCM=m
CONFIG_SND_SOC_UNISOC_COMPR_2STAGE_DMA=m
CONFIG_SND_SOC_UNISOC_VBC_V4=m
CONFIG_SND_SOC_UNISOC_VBC_FE=m
CONFIG_SND_SOC_UNISOC_TDM=m
CONFIG_SND_SOC_UNISOC_DUMMY_CODEC=m
CONFIG_SND_SOC_UNISOC_HEADSET_FSA4480=m
CONFIG_SND_SOC_UNISOC_PA_AW87XXX=m
CONFIG_SND_SOC_UNISOC_CODEC_UMP9620=m
CONFIG_SND_SOC_UNISOC_CODEC_UMP9620_POWER=m
CONFIG_SND_SOC_UNISOC_CODEC_UMP9620_POWER_DEV=m
CONFIG_SND_SOC_UNISOC_PDM_R2P0=m
CONFIG_SND_SOC_UNISOC_CARD=m
CONFIG_UNISOC_AUDIO=y
CONFIG_UNISOC_AUDIO_MEM=m
CONFIG_UNISOC_AUDIO_AGDSP_PD=m
CONFIG_UNISOC_AUDIO_SIPC=m
CONFIG_UNISOC_AUDIO_PIPE=m
CONFIG_UNISOC_AUDIO_APIPE=m
CONFIG_UNISOC_AUDIO_CP_BOOT=m
CONFIG_UNISOC_AUDIO_CP_DVFS=m
CONFIG_UNISOC_AUDIO_DSP_DUMP=m
CONFIG_UNISOC_AUDIO_VOICE_TRIGGER_IRQ=m
CONFIG_UNISOC_AUDIO_MCDT_R2P0=m

# KVM and containers, aligned with mu300-mainline.config (6.18/7.2).
# Optional networking modules are loaded on demand, never during early boot.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST_NET=m
CONFIG_VSOCKETS=m
CONFIG_VHOST_VSOCK=m
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BINFMT_MISC=m
CONFIG_PSI=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_MISC=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
# Keep OpenWrt's nftables backend; do not enable competing legacy tables.
CONFIG_BRIDGE_NETFILTER=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_IP_VS=m
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_NFCT=y
CONFIG_DUMMY=m
CONFIG_MACVTAP=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_FUSE_FS=m

# Optional observability. No tracer, perf session or BPF program is started at boot.
# DWARF remains in build artifacts; compact BTF is retained in the kernel/modules.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_ARM_PMU=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# Tickless idle, as in mu300-linux 986e5d0; HIGH_RES_TIMERS is already enabled.
# Does not change application polling or suspend the system/radios.
CONFIG_NO_HZ_IDLE=y

# Common traffic-control and virtual-network tools, loaded only when requested.
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_TBF=m
CONFIG_NET_SCH_PRIO=m
CONFIG_NET_SCH_NETEM=m
CONFIG_NET_CLS_U32=m
CONFIG_NET_CLS_FLOWER=m
CONFIG_NET_CLS_MATCHALL=m
CONFIG_NET_ACT_BPF=m
CONFIG_NET_ACT_MIRRED=m
CONFIG_NET_ACT_POLICE=m
CONFIG_NET_ACT_GACT=m
CONFIG_NET_ACT_SKBEDIT=m
CONFIG_NET_ACT_CT=m
CONFIG_IFB=m
CONFIG_NETLINK_DIAG=m
CONFIG_UNIX_DIAG=m
CONFIG_PACKET_DIAG=m
CONFIG_IPVTAP=m
CONFIG_GENEVE=m

# Adapted from MU300 PR #228; optional modules are not loaded at boot.
# --- extended VM/container support: guest transports, shared directories and checkpoint/restore
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=m
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_INPUT=m
CONFIG_VIRTIO_FS=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_NET_9P=m
CONFIG_NET_9P_VIRTIO=m
CONFIG_9P_FS=m
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_USERFAULTFD=y
CONFIG_HUGETLBFS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_TARGET_CORE=m
CONFIG_VHOST_SCSI=m

# --- routing and traffic control: multicast, MPLS, multipath TCP and additional tc actions
CONFIG_IP_MULTICAST=y
CONFIG_IP_MROUTE=y
CONFIG_IP_MROUTE_MULTIPLE_TABLES=y
CONFIG_IP_PIMSM_V2=y
CONFIG_IPV6_MROUTE=y
CONFIG_IPV6_MROUTE_MULTIPLE_TABLES=y
CONFIG_IPV6_PIMSM_V2=y
CONFIG_IPV6_SIT=m
CONFIG_NET_IPGRE_BROADCAST=y
CONFIG_MPLS=y
CONFIG_NET_MPLS_GSO=m
CONFIG_MPLS_ROUTING=m
CONFIG_LWTUNNEL=y
CONFIG_MPLS_IPTUNNEL=m
CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y
CONFIG_TCP_CONG_HYBLA=m
CONFIG_TCP_CONG_HTCP=m
CONFIG_TCP_CONG_VEGAS=m
CONFIG_TCP_CONG_WESTWOOD=m
CONFIG_NET_SCH_SFB=m
CONFIG_NET_SCH_CHOKE=m
CONFIG_NET_SCH_QFQ=m
CONFIG_NET_SCH_TEQL=m
CONFIG_NET_ACT_SAMPLE=m
CONFIG_NET_ACT_SKBMOD=m
CONFIG_NET_ACT_GATE=m
CONFIG_NET_ACT_MPLS=m
CONFIG_NFT_REJECT_NETDEV=m
CONFIG_NETFILTER_XT_TARGET_HMARK=m
CONFIG_NETFILTER_XT_TARGET_RATEEST=m
CONFIG_NETFILTER_XT_MATCH_RATEEST=m
CONFIG_NETFILTER_XT_TARGET_TCPOPTSTRIP=m

# --- storage: complete NFSv4, filesystem ACLs/encryption and LVM/RAID targets
CONFIG_NFSD_V4=y
CONFIG_NFS_V4_2=y
CONFIG_CIFS_XATTR=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_DM_CACHE=m
CONFIG_DM_WRITECACHE=m
CONFIG_DM_MULTIPATH=m
CONFIG_DM_INTEGRITY=m
CONFIG_DM_MIRROR=m
CONFIG_MD_RAID456=m
CONFIG_NLS_CODEPAGE_857=m
CONFIG_NLS_ISO8859_9=m

# --- USB peripherals: older ASIX adapters, generic serial, USB/IP and UVC webcams
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USBIP_CORE=m
CONFIG_USBIP_HOST=m
CONFIG_USBIP_VHCI_HCD=m
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_NFSD=m
CONFIG_CIFS=m
CONFIG_XFS_FS=m
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_BLK_DEV_DM=m
CONFIG_MD=y
CONFIG_BLK_DEV_MD=m
CONFIG_VIRTIO_MENU=y
CONFIG_PCI=y
CONFIG_NET_IPGRE_DEMUX=m
