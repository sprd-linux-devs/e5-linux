+	$(INSTALL_BIN) ./files/usr/libexec/e5-network-recovery $(1)/usr/libexec
+	$(INSTALL_BIN) ./files/etc/init.d/e5-network-recovery $(1)/etc/init.d
+	$(LN) ../init.d/e5-network-recovery $(1)/etc/rc.d/S96e5-network-recovery
+	$(LN) ../init.d/e5-network-recovery $(1)/etc/rc.d/K10e5-network-recovery
 
