 	$(INSTALL_BIN) ./files/usr/sbin/ModemManager-wrapper $(1)/usr/sbin
 	$(INSTALL_BIN) ./files/usr/sbin/ModemManager-monitor $(1)/usr/sbin
+	$(INSTALL_BIN) ./files/usr/sbin/modemmanager-unisoc-renew $(1)/usr/sbin
