#!/usr/bin/python3
"""CPU policies and passive CPU cooling, shared by LuCI and the info screen."""
import fcntl
import json
import os
from pathlib import Path
import re
import sys
import subprocess
import time


# Every firmware is checked against its actual DVFS_INIT/decoder/selector ABI,
# including DHTB integrity, rather than a whole-image or sized-image hash list.
VOLTAGE_CAPABILITY_CACHE = 'voltage-supported-v10'
VOLTAGE_SOC_UNSUPPORTED = 'CPU voltage adjustment is not supported on this SoC'
VOLTAGE_DRIVER_UNSUPPORTED = 'CPU voltage interface is missing from this kernel'
VOLTAGE_NOT_READY = 'SML partitions are not ready; refresh after initialization'
VOLTAGE_READ_FAILED = 'SML partitions could not be read; refresh and check storage'
VOLTAGE_ABI_UNKNOWN = 'SML voltage ABI could not be established'
VOLTAGE_CHECKER_UNAVAILABLE = 'SML compatibility checker is not ready; refresh after installation'


def voltage_module_supported(path):
    try:
        data = path.read_bytes()
    except OSError:
        return False
    # The module loader still verifies vermagic, relocations and dependencies.
    # This only checks that our boot parameter is actually declared, so an old
    # module can retain ordinary frequency control without an unknown argument.
    return (len(data) >= 20 and data[:6] == b'\x7fELF\x02\x01' and
            int.from_bytes(data[18:20], 'little') == 183 and
            re.search(rb'\x00parm=voltage_offset_uv:[^\x00]+\x00', data) is not None)


def read(path, default=''):
    try:
        return path.read_text().strip()
    except OSError:
        return default


def number(path, default=None):
    try:
        return int(read(path))
    except ValueError:
        return default


def atomic_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + '.new')
    with tmp.open('w') as stream:
        os.chmod(tmp, 0o600)
        json.dump(data, stream, separators=(',', ':'))
        stream.flush()
        os.fsync(stream.fileno())
    tmp.replace(path)
    fd = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


class Control:
    def __init__(self, root=Path('/')):
        self.root = root
        self.cpu = root / 'sys/devices/system/cpu/cpufreq'
        self.thermal = root / 'sys/class/thermal'
        self.config = root / 'etc/e5-cpu.json'
        self.runtime = root / 'run/e5-cpu'
        self.voltage_config = root / 'etc/e5-cpu-voltage.json'
        self.voltage_armed = root / 'etc/e5-cpu-voltage-armed.json'
        self.voltage_unavailable_reason = None

    def voltage_driver(self):
        release = read(self.root / 'proc/sys/kernel/osrelease')
        return self.root / 'lib/modules' / release / 'sprd-cpufreq-v2-driver.ko'

    def voltage_supported(self):
        """Recognize each slot's actual ABI independently of firmware build ID.

        Slots may have different versions. Check each one's compatibility,
        never require byte-for-byte image identity or rewrite either slot.
        """
        compatibles = read(self.root/'sys/firmware/devicetree/base/compatible').split('\0')
        if not {'sprd,ums9620','sprd,ums9621'}.intersection(compatibles):
            self.voltage_unavailable_reason = VOLTAGE_SOC_UNSUPPORTED
            return False
        if not voltage_module_supported(self.voltage_driver()):
            self.voltage_unavailable_reason = VOLTAGE_DRIVER_UNSUPPORTED
            return False
        cache = self.runtime/VOLTAGE_CAPABILITY_CACHE
        cached = read(cache)
        if cached == '1' or cached.startswith('0:'):
            self.voltage_unavailable_reason = None if cached == '1' else cached[2:]
            return cached == '1'
        checker = self.root/'usr/libexec/unisoc-modem/sml-voltage-check'
        results = {}
        failed = False
        for entry in (self.root/'sys/class/block').glob('*/uevent'):
            fields = dict(line.split('=',1) for line in read(entry).splitlines() if '=' in line)
            name = fields.get('PARTNAME')
            if name not in ('sml_a','sml_b'):
                continue
            if name in results:
                results[name] = False
                continue
            try:
                with (self.root/'dev'/entry.parent.name).open('rb') as stream:
                    data = stream.read(4*1024*1024+1)
            except OSError:
                failed = True
                continue
            if not checker.is_file():
                self.voltage_unavailable_reason = VOLTAGE_CHECKER_UNAVAILABLE
                return False
            try:
                result = subprocess.run([str(checker),'-'],input=data,capture_output=True,timeout=3)
                if result.returncode not in (0, 1):
                    self.voltage_unavailable_reason = VOLTAGE_CHECKER_UNAVAILABLE
                    return False
                results[name] = result.returncode == 0
            except (OSError,subprocess.SubprocessError):
                # Missing/incomplete helper after a hot update is transient.
                self.voltage_unavailable_reason = VOLTAGE_CHECKER_UNAVAILABLE
                return False
        reason = None
        if len(results)!=2 or failed:
            self.voltage_unavailable_reason = VOLTAGE_READ_FAILED if failed else VOLTAGE_NOT_READY
            return False  # do not cache an early discovery/read failure
        if not all(results.values()):
            reason = VOLTAGE_ABI_UNKNOWN
        self.voltage_unavailable_reason = reason
        self.runtime.mkdir(parents=True,exist_ok=True)
        cache.write_text('1' if reason is None else '0:'+reason)
        return reason is None

    def voltage_profile(self):
        if not self.voltage_config.exists():
            return [0, 0, 0]
        data = json.loads(self.voltage_config.read_text())
        if not isinstance(data, dict) or set(data) != {'version', 'offsets'} or data['version'] != 1:
            raise ValueError('Invalid voltage profile')
        values = data['offsets']
        if not isinstance(values, list) or len(values) != 3:
            raise ValueError('Expected three voltage domains')
        for value in values:
            self.validate_voltage(value)
        return values

    @staticmethod
    def validate_voltage(value):
        if type(value) is not int or not -50000 <= value <= 25000 or value % 3125:
            raise ValueError('Voltage offset must be -50000..25000 uV in 3125 uV steps')

    def load_driver(self):
        if list(self.cpu.glob('policy[0-9]*')):
            return
        release = read(self.root / 'proc/sys/kernel/osrelease')
        driver = self.voltage_driver()
        if not release or not driver.exists():
            return
        offsets = [0, 0, 0]
        keep_profile = False
        try:
            # A marker survives crashes, hard power loss and failed boots.
            # Normal rc shutdown removes it; a stale marker disarms the profile.
            if self.voltage_armed.exists():
                raise ValueError('Unclean shutdown with custom voltage; restored factory voltage')
            offsets = self.voltage_profile()
            if any(offsets) and not self.voltage_supported():
                keep_profile = self.voltage_unavailable_reason in (VOLTAGE_DRIVER_UNSUPPORTED, VOLTAGE_NOT_READY, VOLTAGE_READ_FAILED, VOLTAGE_CHECKER_UNAVAILABLE)
                raise ValueError(self.voltage_unavailable_reason)
        except (OSError, ValueError) as error:
            offsets = [0, 0, 0]
            # Keep a saved profile if the matching driver has not been installed.
            # Use factory voltage without reinitializing DVFS later in this boot.
            if self.voltage_config.exists() and not keep_profile:
                self.voltage_config.replace(self.voltage_config.with_suffix('.rejected.json'))
            (self.runtime / 'voltage-error').write_text(
                self.voltage_unavailable_reason if keep_profile else str(error))
            self.disarm_voltage()
        commandline = read(self.root / 'sys/firmware/devicetree/base/chosen/bootargs')
        if re.search(r'(?:^|\s)(?:sprdboot|androidboot)\.mode=charger(?:\s|\0|$)', commandline):
            offsets = [0, 0, 0]
        if any(offsets):
            atomic_json(self.voltage_armed, {'offsets': offsets})
        command = ['insmod', str(driver)]
        if voltage_module_supported(driver):
            command.append('voltage_offset_uv=' + ','.join(map(str, offsets)))
        subprocess.run(command, check=True, capture_output=True, text=True)
        if not list(self.cpu.glob('policy[0-9]*')):
            raise ValueError('CPU driver failed to initialize; reboot to restore default voltage')

    def disarm_voltage(self):
        if self.voltage_armed.exists():
            self.voltage_armed.unlink()
            fd = os.open(self.voltage_armed.parent, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)

    def snapshot(self):
        policies = []
        voltage_error = read(self.runtime / 'voltage-error') or None
        try:
            pending = self.voltage_profile()
        except (OSError, ValueError) as error:
            pending = [0, 0, 0]
            voltage_error = str(error)
        rails = {name: number(p / 'microvolts')
                 for p in (self.root / 'sys/class/regulator').glob('regulator.*')
                 if (name := read(p / 'name')).startswith(('vddcpu', 'vddsram'))}
        voltage_checked = False
        firmware_supported = False
        for path in sorted(self.cpu.glob('policy[0-9]*')):
            if not re.fullmatch(r'policy[0-9]+', path.name):
                continue
            freqs = [int(v) for v in read(path / 'scaling_available_frequencies').split() if v.isdigit()]
            volts = []
            for line in read(path / 'scaling_voltage_table').splitlines():
                pair = line.split()
                if len(pair) == 2 and all(v.isdigit() for v in pair):
                    volts.append({'khz': int(pair[0]), 'uv': int(pair[1])})
            domain = number(path / 'scaling_voltage_domain')
            offset = number(path / 'scaling_voltage_offset')
            interface = (domain in (0, 1, 2) and offset is not None and
                         read(path / 'scaling_driver') == 'sprd-cpufreq-v2')
            if interface and not voltage_checked:
                firmware_supported = self.voltage_supported()
                voltage_checked = True
            editable = interface and firmware_supported
            # Verified SML routes domain 0/1/2 to PMIC CPU1/CPU2/CPU0.
            # Regulator numbering does not follow Linux policy/domain numbering.
            compatible = read(self.root / 'sys/firmware/devicetree/base/compatible').split('\0')
            rail = (1, 2, 0)[domain] if editable and 'sprd,ums9621' in compatible else None
            policies.append({
                'id': path.name, 'cpus': read(path / 'related_cpus'),
                'writable': bool(freqs and read(path / 'scaling_available_governors') and
                                 number(path / 'scaling_min_freq') is not None and
                                 number(path / 'scaling_max_freq') is not None and
                                 (not (path / 'affected_cpus').exists() or read(path / 'affected_cpus'))),
                'driver': read(path / 'scaling_driver'),
                'current': number(path / 'cpuinfo_cur_freq', number(path / 'scaling_cur_freq')),
                'min': number(path / 'scaling_requested_min_freq', number(path / 'scaling_min_freq')),
                'max': number(path / 'scaling_requested_max_freq', number(path / 'scaling_max_freq')),
                'effective_min': number(path / 'scaling_min_freq'),
                'effective_max': number(path / 'scaling_max_freq'),
                'hardware_min': number(path / 'cpuinfo_min_freq'),
                'hardware_max': number(path / 'cpuinfo_max_freq'),
                'frequencies': sorted(set(freqs)),
                'governor': read(path / 'scaling_governor'),
                'governors': read(path / 'scaling_available_governors').split(),
                'voltages': volts,
                'voltage_domain': domain, 'voltage_offset': offset,
                'voltage_next': pending[domain] if domain in (0, 1, 2) else None,
                'voltage_boot_writable': editable,
                'voltage_actual': rails.get(f'vddcpu{rail}'),
                'sram_voltage_actual': rails.get(f'vddsram{rail}'),
            })
        zones = []
        for path in sorted(self.thermal.glob('thermal_zone[0-9]*')):
            cooling = []
            for link in path.glob('cdev[0-9]*'):
                if not re.fullmatch(r'cdev[0-9]+', link.name) or not link.is_dir():
                    continue
                kind = read(link / 'type')
                if kind.startswith('cpufreq'):
                    cooling.append({'type': kind, 'state': number(link / 'cur_state'),
                                    'max_state': number(link / 'max_state'),
                                    'trip': number(path / (link.name + '_trip_point'))})
            trips = []
            for temp in sorted(path.glob('trip_point_*_temp')):
                match = re.fullmatch(r'trip_point_(\d+)_temp', temp.name)
                if not match:
                    continue
                index = int(match[1])
                kind = read(path / f'trip_point_{index}_type')
                trips.append({'id': index, 'type': kind, 'temp': number(temp),
                              'throttles_cpu': any(c['trip'] == index for c in cooling),
                              'hysteresis': number(path / f'trip_point_{index}_hyst'),
                              'writable': kind == 'passive' and bool(cooling) and bool(temp.stat().st_mode & 0o200)})
            if trips or cooling:
                zones.append({'id': path.name, 'name': read(path / 'type'),
                              'temp': number(path / 'temp'), 'trips': trips, 'cooling': cooling})
        return {'ok': True, 'available': bool(policies), 'policies': policies, 'zones': zones,
                'persistent': self.config.exists(), 'voltage_writable': False,
                'voltage_boot_writable': any(p['voltage_boot_writable'] for p in policies),
                'voltage_reboot_required': any(p['voltage_offset'] != p['voltage_next']
                                              for p in policies if p['voltage_offset'] is not None),
                'voltage_min': -50000, 'voltage_max': 25000, 'voltage_step': 3125,
                'voltage_unavailable_reason': (self.voltage_unavailable_reason if voltage_checked else
                    'CPU voltage interface is missing from this kernel' if policies else None),
                'voltage_error': voltage_error,
                'overclock_available': False,
                'last_boot_error': read(self.runtime / 'boot-error') or None}

    @staticmethod
    def settings(state):
        return {'policies': [{k: p[k] for k in ('id', 'cpus', 'min', 'max', 'governor')}
                             for p in state['policies'] if p.get('writable', True)],
                'thermal': [{'zone': z['name'], 'trip': t['id'], 'temp': t['temp']}
                            for z in state['zones'] for t in z['trips'] if t['writable']]}

    def defaults(self):
        path = self.runtime / 'defaults.json'
        if not path.exists():
            atomic_json(path, self.settings(self.snapshot()))
        return json.loads(path.read_text())

    def write(self, path, value):
        with path.open('w') as stream:
            stream.write(str(value) + '\n')
        if path.name in ('scaling_min_freq', 'scaling_max_freq'):
            requested = path.with_name(path.name.replace('scaling_', 'scaling_requested_'))
            if requested.exists():
                path = requested
        # CPUFreq applies frequency QoS changes on a workqueue. An immediate
        # read may still show the old limit even though the write succeeded.
        deadline = time.monotonic() + 0.75
        while read(path) != str(value):
            if time.monotonic() >= deadline:
                raise ValueError('Kernel did not accept ' + path.name)
            time.sleep(0.02)

    @staticmethod
    def integer(value):
        if type(value) is not int:
            raise ValueError('Expected an integer')
        return value

    def apply(self, changes, persist=None):
        if not isinstance(changes, dict) or set(changes) - {'policies', 'thermal'}:
            raise ValueError('Unknown CPU setting')
        if persist is not None and type(persist) is not bool:
            raise ValueError('Invalid persistence flag')
        state = self.snapshot()
        self.defaults()
        steps, seen = [], set()
        next_voltage = None
        for p in changes.get('policies', []):
            if not isinstance(p, dict) or set(p) - {'id', 'cpus', 'min', 'max', 'governor', 'voltage_next'}:
                raise ValueError('Invalid CPU policy')
            current = next((v for v in state['policies'] if v['id'] == p.get('id')), None)
            if not current or current['id'] in seen:
                raise ValueError('CPU policy missing or repeated')
            seen.add(current['id'])
            if not current.get('writable', True):
                raise ValueError('CPU policy is offline; enable its cores before changing frequency')
            if 'voltage_next' in p:
                self.validate_voltage(p['voltage_next'])
                if not current['voltage_boot_writable']:
                    raise ValueError('Boot voltage adjustment unavailable for this kernel/firmware')
                if next_voltage is None:
                    next_voltage = self.voltage_profile()
                next_voltage[current['voltage_domain']] = p['voltage_next']
            if 'cpus' in p and p['cpus'] != current['cpus']:
                raise ValueError('CPU topology changed; reset saved settings')
            low = self.integer(p.get('min', current['min']))
            high = self.integer(p.get('max', current['max']))
            gov = p.get('governor', current['governor'])
            if low not in current['frequencies'] or high not in current['frequencies'] or low > high:
                raise ValueError('Choose supported frequencies with minimum <= maximum')
            if gov not in current['governors']:
                raise ValueError('Governor unavailable')
            path = self.cpu / current['id']
            # Crossing ranges require raising max first or lowering min first.
            limits = [('scaling_min_freq', low), ('scaling_max_freq', high)]
            if low > current['max']:
                limits.reverse()
            steps.extend((path / name, value) for name, value in limits)
            steps.append((path / 'scaling_governor', gov))
        proposed = {}
        for item in changes.get('thermal', []):
            if not isinstance(item, dict) or set(item) != {'zone', 'trip', 'temp'}:
                raise ValueError('Invalid thermal setting')
            index, temp = self.integer(item['trip']), self.integer(item['temp'])
            zones = [z for z in state['zones'] if z['name'] == item['zone']]
            if len(zones) != 1:
                raise ValueError('CPU thermal zone unavailable or ambiguous')
            zone = zones[0]
            trip = next((t for t in zone['trips'] if t['id'] == index), None)
            key = (zone['name'], index)
            if key in proposed or not trip or not trip['writable']:
                raise ValueError('Only writable passive CPU trips may be changed')
            critical = [t['temp'] for t in zone['trips'] if t['type'] in ('critical', 'hot') and t['temp']]
            ceiling = min([100000] + [t - 10000 for t in critical])
            if not 40000 <= temp <= ceiling or temp % 1000:
                raise ValueError('Temperature must use 1 C steps within the protected range')
            proposed[key] = temp
            steps.append((self.thermal / zone['id'] / f'trip_point_{index}_temp', temp))
        for zone in state['zones']:
            temps = [proposed.get((zone['name'], t['id']), t['temp'])
                     for t in zone['trips'] if t['type'] == 'passive']
            if any(b - a < 1000 for a, b in zip(temps, temps[1:])):
                raise ValueError('Passive trip temperatures must increase by at least 1 C')
        undo = []
        previous_config = self.config.read_bytes() if self.config.exists() else None
        previous_voltage = self.voltage_config.read_bytes() if self.voltage_config.exists() else None
        try:
            for path, value in steps:
                requested = path.with_name(path.name.replace('scaling_', 'scaling_requested_'))
                before = read(requested if requested.exists() else path)
                if before != str(value):
                    undo.append((path, before))
                    self.write(path, value)
            if persist is True or (persist is None and self.config.exists()):
                profile = self.settings(self.snapshot())
                # Keep saved requests for offline clusters. They will be online
                # when frequency replay runs, before the optional hotplug replay.
                active = {p['id'] for p in profile['policies']}
                if previous_config:
                    profile['policies'].extend(p for p in json.loads(previous_config).get('policies', [])
                                               if p['id'] not in active)
                atomic_json(self.config, profile)
            elif persist is False:
                self.config.unlink(missing_ok=True)
            if next_voltage is not None:
                atomic_json(self.voltage_config, {'version': 1, 'offsets': next_voltage})
                (self.runtime / 'voltage-error').unlink(missing_ok=True)
        except (OSError, ValueError) as error:
            failures = []
            for path, value in reversed(undo):
                try:
                    self.write(path, value)
                except (OSError, ValueError):
                    failures.append(path.name)
            for path, previous in ((self.config, previous_config), (self.voltage_config, previous_voltage)):
                try:
                    current = path.read_bytes() if path.exists() else None
                    if current == previous:
                        continue
                    if previous is None:
                        path.unlink(missing_ok=True)
                        fd = os.open(path.parent, os.O_RDONLY)
                        try:
                            os.fsync(fd)
                        finally:
                            os.close(fd)
                    else:
                        atomic_json(path, json.loads(previous))
                except (OSError, ValueError):
                    failures.append(path.name)
            if failures:
                raise ValueError(f'{error}; rollback failed: {", ".join(failures)}') from error
            raise
        return self.snapshot()

    def set_item(self, item, value):
        if item == 'persist':
            return self.apply({}, value)
        if item == 'reset':
            result = self.apply(self.defaults(), False)
            if self.voltage_config.exists():
                atomic_json(self.voltage_config, {'version': 1, 'offsets': [0, 0, 0]})
            return self.snapshot()
        match = re.fullmatch(r'(policy\d+)_(min|max|governor|voltage_next)', item)
        if match:
            key = match[2]
            if key != 'governor':
                if not re.fullmatch(r'-?[0-9]+', str(value)):
                    raise ValueError('Invalid frequency')
                value = int(value)
            return self.apply({'policies': [{'id': match[1], key: value}]})
        match = re.fullmatch(r'(thermal_zone\d+)_trip(\d+)', item)
        if match:
            zone = next((z for z in self.snapshot()['zones'] if z['id'] == match[1]), None)
            if not zone:
                raise ValueError('Thermal zone unavailable')
            return self.apply({'thermal': [{'zone': zone['name'], 'trip': int(match[2]),
                                            'temp': self.integer(value) * 1000}]})
        raise ValueError('Unsupported CPU setting')

    def boot(self):
        self.runtime.mkdir(parents=True, exist_ok=True)
        self.load_driver()
        self.defaults()
        if self.config.exists():
            try:
                self.apply(json.loads(self.config.read_text()), None)
                (self.runtime / 'boot-error').unlink(missing_ok=True)
            except (OSError, ValueError) as error:
                # Keep the rejected profile available for inspection, without
                # repeatedly applying it on future boots.
                self.config.replace(self.config.with_suffix('.rejected.json'))
                (self.runtime / 'boot-error').write_text(str(error))
                raise
        return self.snapshot()


def main():
    method = sys.argv[1] if len(sys.argv) > 1 else 'get'
    controller = Control()
    controller.runtime.mkdir(parents=True, exist_ok=True)
    with (controller.runtime / 'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if method == 'get':
                result = controller.snapshot()
            elif method == 'boot':
                result = controller.boot()
            elif method == 'shutdown':
                controller.disarm_voltage()
                result = {'ok': True}
            elif method == 'apply':
                request = json.load(sys.stdin)
                result = controller.apply(request.get('changes', {}), request.get('persist'))
            elif method == 'set':
                request = json.loads(sys.argv[2]) if len(sys.argv) > 2 else json.load(sys.stdin)
                result = controller.set_item(request.get('id', ''), request.get('value'))
            elif method == 'reset':
                result = controller.set_item('reset', None)
            else:
                raise ValueError('Unknown operation')
        except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError) as error:
            result = {'ok': False, 'error': str(error)}
        print(json.dumps(result, separators=(',', ':')))


if __name__ == '__main__':
    main()
